<svg width="1000" height="430" viewBox="0 0 1000 430" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1000" y2="430" gradientUnits="userSpaceOnUse">
      <stop stop-color="#0B0F14"/>
      <stop offset="1" stop-color="#111A24"/>
    </linearGradient>
    <linearGradient id="scan" x1="0" y1="0" x2="0" y2="1">
      <stop stop-color="#7EE787" stop-opacity="0"/>
      <stop offset="0.5" stop-color="#7EE787" stop-opacity="0.16"/>
      <stop offset="1" stop-color="#7EE787" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="glowLine" x1="0" y1="0" x2="1" y2="0">
      <stop stop-color="#7EE787" stop-opacity="0.10"/>
      <stop offset="0.5" stop-color="#7EE787" stop-opacity="0.95"/>
      <stop offset="1" stop-color="#7EE787" stop-opacity="0.10"/>
    </linearGradient>
    <pattern id="grid" width="28" height="28" patternUnits="userSpaceOnUse">
      <path d="M 28 0 L 0 0 0 28" fill="none" stroke="#FFFFFF" stroke-opacity="0.035" stroke-width="1"/>
    </pattern>
    <filter id="softGlow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
    <clipPath id="terminalClip">
      <rect x="40" y="72" width="920" height="314" rx="14"/>
    </clipPath>
  </defs>

  <style>
    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace; }
    .text { fill: #E6EDF3; }
    .muted { fill: #7D8590; }
    .accent { fill: #7EE787; }
    .blink { animation: blink 1.1s steps(1) infinite; }
    .scanline { animation: scanline 6s linear infinite; }
    .boot1 { animation: show1 12s steps(1) infinite; }
    .boot2 { opacity: 0; animation: show2 12s steps(1) infinite; }
    .boot3 { opacity: 0; animation: show3 12s steps(1) infinite; }
    .boot4 { opacity: 0; animation: show4 12s steps(1) infinite; }
    .boot5 { opacity: 0; animation: show5 12s steps(1) infinite; }
    .type1 { opacity: 0; animation: type1 12s steps(1) infinite; }
    .type2 { opacity: 0; animation: type2 12s steps(1) infinite; }
    .rocketLaunch {
      opacity: 0;
      animation: rocketLaunch 5.8s cubic-bezier(.32,.05,.18,1) 1.7s 1 both;
      transform-box: fill-box;
      transform-origin: center;
    }
    .rocketFlameOuter { animation: flameOuter .18s steps(2,end) infinite; transform-origin: 5px 32px; }
    .rocketFlameInner { animation: flameInner .14s steps(2,end) infinite; transform-origin: 7px 31px; }
    @keyframes blink { 0%,49%{opacity:1} 50%,100%{opacity:0} }
    @keyframes scanline { from{transform:translateY(-80px)} to{transform:translateY(500px)} }
    @keyframes show1 { 0%,100%{opacity:1} }
    @keyframes show2 { 0%,10%{opacity:0} 11%,100%{opacity:1} }
    @keyframes show3 { 0%,23%{opacity:0} 24%,100%{opacity:1} }
    @keyframes show4 { 0%,40%{opacity:0} 41%,100%{opacity:1} }
    @keyframes show5 { 0%,62%{opacity:0} 63%,100%{opacity:1} }
    @keyframes type1 { 0%,100%{opacity:0} 16%,27%{opacity:1} }
    @keyframes type2 { 0%,100%{opacity:0} 30%,42%{opacity:1} }
    @keyframes rocketLaunch {
      0%   { opacity: 0; transform: translate(0px, 12px) rotate(-8deg) scale(.92); }
      7%   { opacity: 1; transform: translate(0px, 0px) rotate(-8deg) scale(1); }
      24%  { opacity: 1; transform: translate(20px, -10px) rotate(-12deg) scale(1); }
      44%  { opacity: 1; transform: translate(68px, -48px) rotate(-19deg) scale(1.02); }
      68%  { opacity: 1; transform: translate(142px, -118px) rotate(-26deg) scale(1.03); }
      88%  { opacity: 1; transform: translate(238px, -208px) rotate(-31deg) scale(1.02); }
      100% { opacity: 0; transform: translate(320px, -286px) rotate(-34deg) scale(.98); }
    }
    @keyframes flameOuter {
      0%,100% { transform: scaleX(1) scaleY(1); opacity: 1; }
      50% { transform: scaleX(.78) scaleY(1.18); opacity: .9; }
    }
    @keyframes flameInner {
      0%,100% { transform: scaleX(.84) scaleY(1.05); opacity: .95; }
      50% { transform: scaleX(1.08) scaleY(.82); opacity: 1; }
    }
    @media (prefers-reduced-motion: reduce) {
      * { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; }
    }
  </style>

  <rect x="1" y="1" width="998" height="428" rx="22" fill="url(#bg)" stroke="#30363D" stroke-width="2"/>
  <rect x="2" y="46" width="996" height="382" fill="url(#grid)"/>

  <circle cx="27" cy="24" r="6" fill="#FF7B72"/>
  <circle cx="48" cy="24" r="6" fill="#D29922"/>
  <circle cx="69" cy="24" r="6" fill="#7EE787"/>
  <text x="500" y="29" text-anchor="middle" class="mono muted" font-size="12">peter@berlin</text>
  <text x="928" y="29" class="mono accent" font-size="11">● ONLINE</text>

  <g clip-path="url(#terminalClip)">
    <rect x="40" y="72" width="920" height="314" rx="14" fill="#0D1117" fill-opacity="0.46" stroke="#30363D"/>
    <rect x="41" y="73" width="918" height="42" fill="#0B1119" fill-opacity="0.9"/>
    <text x="60" y="100" class="mono muted" font-size="12">terminal://profile</text>
    <text x="447" y="100" class="mono muted" font-size="12">session: active</text>

    <g transform="translate(58 138)">
      <text class="mono muted" font-size="13" x="0" y="0">LAST LOGIN: BERLIN / DE</text>

      <g class="boot1">
        <text class="mono accent" font-size="18" x="0" y="38">peter@github</text>
        <text class="mono muted" font-size="18" x="128" y="38">:</text>
        <text class="mono text" font-size="18" x="142" y="38">~$ whoami</text>
      </g>

      <g class="boot2">
        <text class="mono text" font-size="31" font-weight="700" x="0" y="80">PETER MÖLZER</text>
        <text class="mono muted" font-size="14" x="0" y="104">FULL-STACK SOFTWARE DEVELOPER</text>
      </g>

      <g class="boot3">
        <text class="mono accent" font-size="17" x="0" y="144">peter@github</text>
        <text class="mono muted" font-size="17" x="128" y="144">:</text>
        <text class="mono text" font-size="17" x="142" y="144">~$ cat focus.txt</text>
        <text class="mono text" font-size="14" x="0" y="172">building useful systems from UI → infrastructure</text>
        <text class="mono muted" font-size="14" x="0" y="196">TypeScript · React · Next.js · C/C++ · Docker</text>
      </g>

      <!-- one-shot pixel rocket: launches once, then leaves the terminal permanently -->
      <g transform="translate(382 138)">
        <g class="rocketLaunch">
          <g transform="rotate(-18 31 30)">
            <!-- exhaust -->
            <g class="rocketFlameOuter">
              <rect x="0" y="27" width="7" height="7" fill="#FF3B30"/>
              <rect x="-6" y="31" width="8" height="8" fill="#FF6A00"/>
              <rect x="-11" y="35" width="7" height="7" fill="#FFB000"/>
              <rect x="-14" y="38" width="5" height="5" fill="#FFD60A"/>
            </g>
            <g class="rocketFlameInner">
              <rect x="1" y="29" width="6" height="6" fill="#FFD60A"/>
              <rect x="-4" y="33" width="6" height="6" fill="#FFF36D"/>
            </g>

            <!-- dark pixel outline -->
            <rect x="6" y="22" width="6" height="17" fill="#090C10"/>
            <rect x="12" y="14" width="7" height="25" fill="#090C10"/>
            <rect x="19" y="8" width="7" height="31" fill="#090C10"/>
            <rect x="26" y="3" width="18" height="7" fill="#090C10"/>
            <rect x="38" y="9" width="12" height="7" fill="#090C10"/>
            <rect x="44" y="15" width="7" height="16" fill="#090C10"/>
            <rect x="38" y="30" width="7" height="8" fill="#090C10"/>
            <rect x="31" y="37" width="8" height="7" fill="#090C10"/>
            <rect x="18" y="38" width="14" height="7" fill="#090C10"/>

            <!-- body -->
            <rect x="19" y="15" width="7" height="23" fill="#E6EDF3"/>
            <rect x="26" y="10" width="12" height="28" fill="#F5F7FA"/>
            <rect x="38" y="16" width="6" height="14" fill="#F5F7FA"/>
            <rect x="26" y="31" width="12" height="7" fill="#D8DEE4"/>

            <!-- nose -->
            <rect x="38" y="10" width="8" height="7" fill="#F5F7FA"/>
            <rect x="44" y="5" width="7" height="11" fill="#F5F7FA"/>
            <rect x="50" y="3" width="7" height="8" fill="#22B8F0"/>
            <rect x="50" y="11" width="5" height="5" fill="#1098D4"/>

            <!-- window -->
            <rect x="25" y="16" width="7" height="7" fill="#090C10"/>
            <rect x="27" y="17" width="5" height="5" fill="#62D8FF"/>

            <!-- fins -->
            <rect x="12" y="28" width="7" height="11" fill="#FF334C"/>
            <rect x="8" y="32" width="6" height="7" fill="#D90429"/>
            <rect x="32" y="37" width="9" height="7" fill="#FF334C"/>
            <rect x="38" y="34" width="7" height="7" fill="#D90429"/>

            <!-- little black exhaust pixels -->
            <rect x="4" y="18" width="6" height="5" fill="#090C10"/>
            <rect x="-2" y="23" width="5" height="5" fill="#1098D4" opacity=".75"/>
          </g>
        </g>
      </g>

      <g class="boot4">
        <rect x="0" y="220" width="430" height="98" rx="12" fill="#0B1119" stroke="#30363D"/>
        <text class="mono muted" font-size="11" x="16" y="240">runtime / telemetry</text>

        <text class="mono accent" font-size="12" x="16" y="264">$ ls active_projects</text>
        <text class="mono text type1" font-size="12" x="16" y="282">webserv  Inception  fermentStation  shellfolio</text>

        <text class="mono accent type2" font-size="12" x="16" y="300">$ tail -f status.log</text>
        <text class="mono text type2" font-size="12" x="16" y="318">[ok] shipping ideas • [ok] learning fast • [ok] building daily</text>

        <g transform="translate(290 245)">
          <text x="0" y="0" class="mono muted" font-size="10">signal</text>
          <line x1="0" y1="58" x2="112" y2="58" stroke="#30363D"/>
          <line x1="0" y1="10" x2="0" y2="58" stroke="#30363D"/>
          <path d="M3 49 C 15 46, 18 34, 29 38 S 42 56, 53 44 S 68 18, 81 26 S 95 51, 109 17" fill="none" stroke="url(#glowLine)" stroke-width="2.5" stroke-linecap="round"/>
          <circle r="3.5" fill="#7EE787" filter="url(#softGlow)">
            <animateMotion dur="4s" repeatCount="indefinite" path="M3 49 C 15 46, 18 34, 29 38 S 42 56, 53 44 S 68 18, 81 26 S 95 51, 109 17"/>
          </circle>
        </g>
      </g>

      <g class="boot5">
        <text class="mono accent" font-size="17" x="0" y="352">peter@github</text>
        <text class="mono muted" font-size="17" x="128" y="352">:</text>
        <text class="mono text" font-size="17" x="142" y="352">~$ ./explore</text>
        <text class="mono accent" font-size="14" x="0" y="377">[ READY ]</text>
        <text class="mono text" font-size="14" x="88" y="377">scroll down and run a command</text>
        <rect class="blink" x="368" y="361" width="10" height="18" rx="1" fill="#7EE787"/>
      </g>
    </g>
  </g>

  <rect class="scanline" x="2" y="46" width="996" height="74" fill="url(#scan)" pointer-events="none"/>
  <text x="950" y="404" text-anchor="end" class="mono muted" font-size="9">NO JS · SELF-CONTAINED SVG · GITHUB-SAFE</text>
</svg>
